#!/bin/sh
# thmi-hub            start the server now (if it is not running) and open the dashboard
# thmi-hub enable     start it by itself every time you log in      (thmi-hub disable = stop doing that)
# thmi-hub stop       stop it
# thmi-hub status     is it running, and at which address your T-HMI should use
# thmi-hub firewall   let your T-HMI reach it if you use a firewall (asks for your password)
u() { systemctl --user "$@"; }
myip() { (ip route get 192.0.2.1 2>/dev/null || true) | sed -n 's/.* src \([0-9.]*\).*/\1/p' | head -1; }
myip2() { a=$(myip); [ -n "$a" ] || a=$(hostname -I 2>/dev/null | cut -d' ' -f1); echo "$a"; }
case "${1:-open}" in
  open)    u start thmi-hub.service || { echo "Could not start. Try: journalctl --user -u thmi-hub"; exit 1; }
           sleep 1; echo "Dashboard: http://localhost:8765   (T-HMI address: $(myip2))"
           command -v xdg-open >/dev/null && xdg-open http://localhost:8765 >/dev/null 2>&1 & ;;
  enable)  u enable --now thmi-hub.service; loginctl enable-linger "$USER" 2>/dev/null; echo "Will start by itself from now on." ;;
  disable) u disable --now thmi-hub.service; echo "Stopped, and it will no longer start by itself." ;;
  stop)    u stop thmi-hub.service; echo Stopped. ;;
  status)  u is-active thmi-hub.service; echo "T-HMI address: $(myip)"; curl -s localhost:8765/api/diag; echo ;;
  firewall) sudo sh -c 'ufw allow 8765/tcp && ufw allow 8766/udp' ;;
  *) sed -n '2,6p' "$0" ;;
esac
