#!/bin/bash
# EXPERIMENTAL: OpenMediaVault instead of Nextcloud. OpenMediaVault is built for a network cable (it manages the network
# itself and handles Wi-Fi badly), so this only runs when a cable is plugged in. The installer reboots the Pi when done.
[ -f /var/lib/thmi-hub/install-omv ] || exit 0
LOG=/var/lib/thmi-hub/omv.log
if ! ls /sys/class/net/eth0/carrier >/dev/null 2>&1 || [ "$(cat /sys/class/net/eth0/carrier 2>/dev/null)" != 1 ]; then
  echo "OpenMediaVault needs a network cable. Plug one in and restart the Pi." > /var/lib/thmi-hub/omv.status; exit 0
fi
until curl -fsS -m 10 -o /dev/null https://github.com; do sleep 10; done
echo "Installing OpenMediaVault (20-40 minutes, the Pi restarts when finished)..." > /var/lib/thmi-hub/omv.status
curl -fsSL https://raw.githubusercontent.com/OpenMediaVault-Plugin-Developers/installScript/master/install -o /tmp/omv-install.sh || { echo "Could not download the OpenMediaVault installer" > /var/lib/thmi-hub/omv.status; exit 1; }
rm -f /var/lib/thmi-hub/install-omv
touch /var/lib/thmi-hub/omv-installed
# the OpenMediaVault web page moves to port 8081 so this Pi's dashboard keeps port 80
cat > /usr/local/bin/thmi-omv-port <<'P'
#!/bin/bash
command -v omv-confdbadm >/dev/null || exit 0
omv-confdbadm read conf.webadmin | jq '.port=8081|.enablessl=false' | omv-confdbadm update conf.webadmin - && omv-salt deploy run nginx
rm -f /etc/systemd/system/multi-user.target.wants/thmi-omv-port.service
P
chmod +x /usr/local/bin/thmi-omv-port
cat > /etc/systemd/system/thmi-omv-port.service <<'S'
[Unit]
Description=Move OpenMediaVault web page to port 8081
After=openmediavault-engined.service
[Service]
Type=oneshot
ExecStart=/usr/local/bin/thmi-omv-port
[Install]
WantedBy=multi-user.target
S
systemctl enable thmi-omv-port.service
bash /tmp/omv-install.sh >> "$LOG" 2>&1
echo "OpenMediaVault is installed. Open http://$(hostname).local:8081 (login: admin / openmediavault, change it right away)." > /var/lib/thmi-hub/omv.status
